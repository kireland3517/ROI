# Copy to .env for local development. Never commit real values.
# On Railway, set these as service environment variables instead.

# --- App ---
# development | production
APP_ENV=development
# true: run without keys (stub address validation, labeled ATTOM fallback)
# false: require Smarty credentials; fail clearly if missing
USE_DEMO_FALLBACK=true

# --- External APIs (names only — set values locally or in Railway) ---
ATTOM_API_KEY=
# Optional: log ATTOM mapping + session facts to the server console (never logs API keys)
# DEBUG_PROPERTY_FACTS=true
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
# Optional: only if Smarty gave you a license slug for US Autocomplete Pro
# (Account → Subscriptions). Usually not required when that is your only
# autocomplete subscription.
SMARTY_LICENSE=

# --- Regression pipeline (separate workstream) ---
AREA_DEFINITIONS_URL=
COMPS_OUTPUT_DIR=comps_output
